<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" /><FrameworkReference Include="Microsoft.AspNetCore.App" /><ProjectReference Include="../JBIDS.Server/JBIDS.Server.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../JBIDS.LocalHelper/JBIDS.LocalHelper.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopyLocalHelperForChecks" AfterTargets="Build">
    <MSBuild Projects="../JBIDS.LocalHelper/JBIDS.LocalHelper.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="HelperTarget" />
    </MSBuild>
    <ItemGroup><HelperFiles Include="@(HelperTarget->'%(RootDir)%(Directory)JBIDS.LocalHelper.*')" /></ItemGroup>
    <Copy SourceFiles="@(HelperFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

