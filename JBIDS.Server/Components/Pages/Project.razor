@page "/projects/{ProjectId:int}"
@rendermode InteractiveServer
@using JBIDS.Server.Data
@using JBIDS.Server.Services
@inject CurriculumService Store
@inject ILogger<Project> Logger

<PageTitle>@(project?.Name ?? "Project") | JBIDS</PageTitle>
<a href="/projects">All projects</a>
@if (error is not null) { <div class="alert alert-danger mt-3" role="alert">@error</div> }
@if (notice is not null) { <div class="alert alert-success mt-3" role="status">@notice</div> }
@if (project is null) { <p class="mt-3">@(loaded ? "Project not found or unavailable." : "Loading project…")</p> }
else
{
    <h1 class="mt-3">@project.Name</h1><p>@project.Description</p>
    <p>@announcements.Count announcements · @objectives.Count objectives · @objectives.Count(o => o.Status == ReviewStatus.Approved) approved</p>
    <nav class="mb-4"><a href="#announcements">Job announcements</a> · <a href="#objectives">Training objectives</a></nav>
    <fieldset disabled="@busy">
    <section id="announcements">
    <h2>Job announcements</h2>
    <button class="btn btn-outline-primary mb-3" @onclick="NewAnnouncement">Add announcement</button>
    @if (announcements.Count == 0) { <p>Add an announcement and paste its text to preserve your source evidence.</p> }
    @foreach (var a in announcements)
    {
        <article class="card mb-3" id="announcement-@a.Id">
        <div class="card-body">
            <h3 class="h5">@a.Title</h3><p>@a.Employer · Collected @a.CollectedOn.ToString("yyyy-MM-dd")</p>
            <a href="@a.Url" target="_blank" rel="noopener noreferrer">Open original announcement</a>
            <details class="my-2"><summary>Preserved announcement text</summary><p style="white-space:pre-wrap">@a.Text</p></details>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditAnnouncement(a)">Edit announcement</button>
            <p class="mt-2 mb-0">Supporting objectives:</p>
            <ul>@foreach (var o in objectives.Where(o => evidence.Any(e => e.ObjectiveId == o.Id && e.AnnouncementId == a.Id)))
            { <li><a href="#objective-@o.Id">@o.Text</a> (@o.Status)</li> }</ul>
        </div></article>
    }
    @if (announcement is not null)
    {
        <div class="border rounded p-3 mb-4">
        <h3 class="h5">@(announcement.Id == 0 ? "Add announcement" : "Edit announcement")</h3>
        <EditForm Model="announcement" OnValidSubmit="SaveAnnouncement" FormName="announcement" @key="announcement">
            <DataAnnotationsValidator /><ValidationSummary />
            <label for="job-title">Job title</label><InputText id="job-title" class="form-control mb-2" @bind-Value="announcement.Title" />
            <label for="employer">Employer</label><InputText id="employer" class="form-control mb-2" @bind-Value="announcement.Employer" />
            <label for="url">Source URL</label><InputText id="url" class="form-control mb-2" @bind-Value="announcement.Url" />
            <label for="collected">Date collected</label><InputDate id="collected" class="form-control mb-2" @bind-Value="announcement.CollectedOn" />
            <label for="source-text">Announcement text</label><InputTextArea id="source-text" rows="8" class="form-control mb-3" @bind-Value="announcement.Text" />
            <p>Changing source text returns affected approved objectives to Draft.</p>
            <button class="btn btn-primary">Save announcement</button>
            <button type="button" class="btn btn-link" @onclick="() => announcement = null">Cancel</button>
        </EditForm></div>
    }
    </section>
    <section id="objectives">
    <h2>Training objectives</h2>
    <button class="btn btn-outline-primary mb-3" @onclick="NewObjective">Add objective</button>
    @if (objectives.Count == 0) { <p>No objectives yet. Create an objective, attach evidence, then review it.</p> }
    @if (objective is not null)
    {
        <div class="border rounded p-3 mb-4">
        <h3 class="h5">@(objective.Id == 0 ? "Add objective" : "Edit objective")</h3>
        <EditForm Model="objective" OnValidSubmit="SaveObjective" FormName="objective" @key="objective">
            <DataAnnotationsValidator /><ValidationSummary />
            <label for="objective-text">Measurable training objective</label><InputTextArea id="objective-text" rows="3" class="form-control mb-2" @bind-Value="objective.Text" />
            <label for="bloom">Bloom's level</label>
            <InputSelect id="bloom" class="form-select mb-3" @bind-Value="objective.Level"><option value="">Choose a level</option>
                @foreach (var level in Enum.GetValues<BloomLevel>()) { <option value="@level">@level</option> }
            </InputSelect>
            <button class="btn btn-primary">Save objective</button>
            <button type="button" class="btn btn-link" @onclick="() => objective = null">Cancel</button>
        </EditForm></div>
    }
    @foreach (var o in objectives)
    {
        <article class="card mb-3" id="objective-@o.Id"><div class="card-body">
        <h3 class="h5">@o.Text</h3><p><strong>@o.Status</strong> · Bloom's level: @o.Level</p>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditObjective(o)">Edit objective</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => NewEvidence(o.Id)">Add evidence</button>
            <button class="btn btn-sm btn-success" @onclick="() => Review(o.Id, ReviewStatus.Approved)">Approve</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => Review(o.Id, ReviewStatus.Rejected)">Reject</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Review(o.Id, ReviewStatus.Draft)">Return to Draft</button>
        </div>
        @if (!evidence.Any(e => e.ObjectiveId == o.Id)) { <p>Add supporting evidence before approval.</p> }
        @foreach (var e in evidence.Where(e => e.ObjectiveId == o.Id))
        {
            var source = announcements.Single(a => a.Id == e.AnnouncementId);
            <div class="border-start border-3 ps-3 mb-3">
                <blockquote style="white-space:pre-wrap">@e.Excerpt</blockquote>
                <a href="#announcement-@source.Id">@source.Title — @source.Employer</a> · <a href="@source.Url" target="_blank" rel="noopener noreferrer">Original source</a>
                <button class="btn btn-sm btn-link" @onclick="() => EditEvidence(e)">Edit evidence</button>
            </div>
        }
        @if (link is not null && link.ObjectiveId == o.Id)
        {
            <EditForm Model="link" OnValidSubmit="SaveEvidence" FormName="evidence" @key="link">
                <DataAnnotationsValidator /><ValidationSummary />
                <label for="source">Supporting announcement</label>
                <InputSelect id="source" class="form-select mb-2" @bind-Value="link.AnnouncementId"><option value="0">Choose an announcement</option>
                    @foreach (var a in announcements) { <option value="@a.Id">@a.Title — @a.Employer</option> }
                </InputSelect>
                <label for="excerpt">Supporting excerpt</label><InputTextArea id="excerpt" rows="4" class="form-control mb-3" @bind-Value="link.Excerpt" />
                <button class="btn btn-primary">Save evidence</button><button type="button" class="btn btn-link" @onclick="() => link = null">Cancel</button>
            </EditForm>
        }
        </div></article>
    }
    </section>
    </fieldset>
}
@code {
    [Parameter] public int ProjectId { get; set; }
    private CurriculumProject? project;
    private List<JobAnnouncement> announcements = [];
    private List<TrainingObjective> objectives = [];
    private List<ObjectiveEvidence> evidence = [];
    private JobAnnouncement? announcement;
    private TrainingObjective? objective;
    private ObjectiveEvidence? link;
    private string? error;
    private string? notice;
    private bool loaded;
    private bool busy;
    protected override async Task OnParametersSetAsync()
    {
        project = null; loaded = false; announcement = null; objective = null; link = null;
        await Run(async () => { await Load(); }, null);
        loaded = true;
    }
    private async Task Load()
    {
        project = await Store.ProjectAsync(ProjectId);
        announcements = await Store.AnnouncementsAsync(ProjectId);
        objectives = await Store.ObjectivesAsync(ProjectId);
        evidence = await Store.EvidenceAsync(ProjectId);
    }
    private async Task Run(Func<Task> action, string? message)
    {
        if (busy) return;
        busy = true; error = null; notice = null;
        try { await action(); notice = message; }
        catch (System.ComponentModel.DataAnnotations.ValidationException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Curriculum operation failed"); error = "Could not complete this operation. Check the database connection and try again."; }
        finally { busy = false; }
    }
    private void NewAnnouncement() => announcement = new() { ProjectId = ProjectId };
    private void EditAnnouncement(JobAnnouncement a) => announcement = new() { Id = a.Id, ProjectId = a.ProjectId, Title = a.Title, Employer = a.Employer, Url = a.Url, Text = a.Text, CollectedOn = a.CollectedOn };
    private void NewObjective() => objective = new() { ProjectId = ProjectId };
    private void EditObjective(TrainingObjective o) => objective = new() { Id = o.Id, ProjectId = o.ProjectId, Text = o.Text, Level = o.Level, Status = o.Status };
    private void NewEvidence(int id) => link = new() { ObjectiveId = id };
    private void EditEvidence(ObjectiveEvidence e) => link = new() { Id = e.Id, ObjectiveId = e.ObjectiveId, AnnouncementId = e.AnnouncementId, Excerpt = e.Excerpt };
    private Task SaveAnnouncement() => Run(async () => { await Store.SaveAnnouncementAsync(announcement!); announcement = null; await Load(); }, "Announcement saved. Affected approvals have been returned to Draft if source text changed.");
    private Task SaveObjective() => Run(async () => { await Store.SaveObjectiveAsync(objective!); objective = null; await Load(); }, "Objective saved. Changed approved objectives return to Draft.");
    private Task SaveEvidence() => Run(async () => { await Store.SaveEvidenceAsync(ProjectId, link!); link = null; await Load(); }, "Evidence saved. Changed approved objectives return to Draft.");
    private Task Review(int id, ReviewStatus status) => Run(async () => { await Store.ReviewAsync(ProjectId, id, status); await Load(); }, $"Objective marked {status}.");
}
